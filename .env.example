# 1QG Website Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED - Core Application
# ===========================================

# Database connection string (PostgreSQL/Neon)
DATABASE_URL=postgresql://user:password@host:5432/database

# Session secret for cookie signing (generate a long random string)
SESSION_SECRET=your-session-secret-min-32-chars

# Application environment
NODE_ENV=development

# ===========================================
# REQUIRED - Replit Authentication
# ===========================================

# Replit OIDC configuration (auto-populated by Replit)
REPL_ID=your-repl-id
ISSUER_URL=https://replit.com/oidc

# Comma-separated list of admin emails
AUTHORIZED_ADMIN_EMAILS=admin@1qg.com

# ===========================================
# OPTIONAL - Email Service (Microsoft Graph)
# ===========================================

# Microsoft Graph API credentials for email sending
MS_GRAPH_CLIENT_ID=your-client-id
MS_GRAPH_CLIENT_SECRET=your-client-secret
MS_GRAPH_TENANT_ID=your-tenant-id

# Sender email address
SENDER_EMAIL=info@1qg.com
ADMIN_EMAIL=admin@1qg.com

# ===========================================
# OPTIONAL - AI Services
# ===========================================

# OpenAI API (auto-populated by Replit AI integration)
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API (auto-populated by Replit AI integration)
AI_INTEGRATIONS_ANTHROPIC_API_KEY=your-anthropic-api-key
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===========================================
# OPTIONAL - Third-Party Services
# ===========================================

# HubSpot CRM integration
HUBSPOT_ACCESS_TOKEN=your-hubspot-token

# Winston AI for plagiarism detection
WINSTON_AI_API_KEY=your-winston-ai-key

# SlideSpeak for PDF generation
SLIDESPEAK_API_KEY=your-slidespeak-key

# Unsplash for blog images
UNSPLASH_ACCESS_KEY=your-unsplash-key

# ===========================================
# OPTIONAL - Security & Verification
# ===========================================

# Cloudflare Turnstile (bot protection)
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# PII Encryption key (for GDPR compliance)
PII_ENCRYPTION_KEY=your-encryption-key-32-chars

# ===========================================
# OPTIONAL - URLs & Configuration
# ===========================================

# Application URLs
BASE_URL=https://1qg.com
SITE_URL=https://1qg.com

# Port (default: 5000)
PORT=5000

# Puppeteer/Chromium path for PDF generation
PUPPETEER_EXECUTABLE_PATH=/path/to/chromium
CHROMIUM_PATH=/path/to/chromium

# ===========================================
# Constancia Brain (enterprise institutional memory)
# See docs/enterprise-brain-architecture.md
# ===========================================

# Dedicated Neon project — SEPARATE from DATABASE_URL above.
# Provision a new Neon project `constancia-brain` and paste its
# pooled connection string here.
BRAIN_DATABASE_URL=postgresql://user:password@host:5432/brain

# Cloudflare R2 — S3-compatible object storage for raw binaries.
# Create a bucket called `constancia-brain` in your R2 account, then
# generate an R2 API token with Object Read & Write on that bucket.
BRAIN_R2_ACCOUNT_ID=your-cloudflare-account-id
BRAIN_R2_ACCESS_KEY_ID=your-r2-access-key
BRAIN_R2_SECRET_ACCESS_KEY=your-r2-secret-key
BRAIN_R2_BUCKET=constancia-brain
# Optional: a public custom domain for read-only URLs (not used in v1)
# BRAIN_R2_PUBLIC_URL=https://brain-files.constancia.com

# Embeddings — OpenAI text-embedding-3-small (1536 dims).
# Reuses the same OpenAI key as the website by default; override only
# if you want a separate billing line for the brain.
BRAIN_EMBEDDINGS_PROVIDER=openai
BRAIN_EMBEDDINGS_MODEL=text-embedding-3-small
# BRAIN_OPENAI_API_KEY=

